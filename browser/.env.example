# Optional. Defaults shown.
PORT=3123
BROWSER_HEADLESS=true
BROWSER_VIEWPORT_W=1280
BROWSER_VIEWPORT_H=800
BROWSER_TIMEOUT_MS=15000
OUTPUT_DIR=.browser-use
OUTPUT_MAX_CHARS=4000
ALLOW_EVAL=false
# v0.2+
DELTA_DEFAULT=true
EFFECT_MAX_CHARS=800
STATE_MAX_LINES=40
RECORD_REDACT=false
EFFING_USE_URL=http://localhost:3123/mcp
# Loopback bridge — lets a containerised server open http://localhost:<port>
# for a dev server bound to 127.0.0.1, with NO vite.config change. Splices
# container loopback to the host gateway and rewrites the HTTP Host: header
# back to localhost (Vite >=6 allowedHosts otherwise 403s). Off when the
# direct dial already works (native runs).
EFFING_BRIDGE=1
# Override the gateway host (default: auto-probe host.docker.internal, then
# gateway.docker.internal). Set EFFING_BRIDGE=0 to disable entirely.
# EFFING_BRIDGE_HOST=host.docker.internal
# Surface internal selector/bridge errors instead of degrading silently
# EFFING_DEBUG=1
# CPU tuning (defaults shown — these are the values compose.yaml ships)
# Close idle sessions after 5 min, idle browser after 10 min ("0" disables)
EFFING_IDLE_TTL_MS=300000
EFFING_BROWSER_TTL_MS=600000
# Abort font+media requests ("image,font,media" for max savings, "none" off)
EFFING_BLOCK_ASSETS=font,media
# Tell pages to skip animations (pair with Chromium flag)
EFFING_REDUCED_MOTION=1
# Snapshot settle after navigation (tracker-heavy pages burn the full window)
EFFING_SETTLE_IDLE_MS=800
# DOM read cap for change detection (layout-free textContent)
EFFING_DOM_CAP=20000
# Session journal (console/network/errors/calls) — "false"/"0" disables
EFFING_JOURNAL=true
# Rotate journal.jsonl to journal.1.jsonl past this size (floored at 10000)
EFFING_JOURNAL_MAX_BYTES=2000000
