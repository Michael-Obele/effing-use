{
  // effing-use MCP servers — both run the published npm package (effing-use).
  // HTTP server (shared across editors): start once with
  //   PORT=3123 bunx --package effing-use effing-use-http
  "servers": {
    "effing-use (http)": {
      "type": "http",
      "url": "http://localhost:3123/mcp"
    },
    "effing-use (stdio)": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "--package",
        "effing-use",
        "effing-use-stdio"
      ],
      "env": {
        "BROWSER_HEADLESS": "true",
        "OUTPUT_DIR": "${workspaceFolder}/.browser-use"
      }
    },
    // npm-published version, pinned — resolves once effing-use@0.1.1 is on npm
    // (published by .github/workflows/publish.yml via Trusted Publisher)
    "effing-use-npm": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "--package",
        "effing-use",
        "effing-use-stdio"
      ],
      "env": {
        "BROWSER_HEADLESS": "true",
        "OUTPUT_DIR": "${workspaceFolder}/.browser-use"
      }
    },
    // effing-use-mobile — its own package in ./mobile, running from Docker.
    // Requires, once per host session:
    //   adb kill-server && adb -a -P 5037 start-server
    //   docker compose -f mobile/compose.yaml build
    // Set the app under test (or drop this entry's -e MOBILE_PACKAGE and mount
    // the Capacitor project so capacitor.config.* supplies appId).
    "effing-use-mobile (docker)": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--add-host=host.docker.internal:host-gateway",
        "-e",
        "ADB_SERVER_SOCKET=tcp:host.docker.internal:5037",
        "-e",
        "MOBILE_CDP_HOST=host.docker.internal",
        "-e",
        "MOBILE_PACKAGE=com.your.app",
        "-e",
        "MOBILE_OUTPUT_DIR=/data",
        "-v",
        "${workspaceFolder}/.effing-mobile:/data",
        "effing-use-mobile:local"
      ]
    }
  }
}