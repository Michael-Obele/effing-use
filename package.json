{
  "name": "effing-use",
  "version": "0.1.1",
  "description": "Token-efficient browser control: 3 tools (act, observe, extract) built with tmcp + Bun + Playwright",
  "license": "MIT",
  "author": "Michael Obubelebra Amachree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michael-Obele/effing-use.git"
  },
  "homepage": "https://github.com/Michael-Obele/effing-use#readme",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "effing-use": "src/index.ts",
    "effing-use-http": "src/http.ts"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun src/index.ts",
    "start:http": "bun src/http.ts",
    "dev": "bun --watch src/index.ts",
    "dev:http": "bun --watch src/http.ts",
    "check": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "browser-automation",
    "tmcp",
    "chromium"
  ],
  "dependencies": {
    "@tmcp/adapter-valibot": "^0.1.6",
    "@tmcp/transport-http": "^0.9.0",
    "@tmcp/transport-stdio": "^0.5.0",
    "playwright": "^1.63.0",
    "tmcp": "^1.20.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
